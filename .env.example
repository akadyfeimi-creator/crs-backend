# Django
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-please
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Supabase Postgres connection string)
# Replace with YOUR connection string from Supabase
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxx.supabase.co:5432/postgres

# CORS - your frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# SSL
DB_SSL_REQUIRE=True